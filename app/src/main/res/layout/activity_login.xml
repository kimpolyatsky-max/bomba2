<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="סמל האפליקציה"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_brand_mark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="ברוכים השבים"
            android:textColor="#101827"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:text="התחברו לחשבון שלכם כדי להמשיך"
            android:textColor="#697586"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etUser"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#CBD5E1"
            android:gravity="center_vertical|right"
            android:hint="שם משתמש"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etPass"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="22dp"
            android:backgroundTint="#CBD5E1"
            android:gravity="center_vertical|right"
            android:hint="סיסמה"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#147D64"
            android:gravity="center"
            android:text="כניסה"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvToRegister"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="אין לכם חשבון? הרשמה"
            android:textColor="#147D64"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
